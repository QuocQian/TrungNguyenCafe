@model TrungNguyenCafe.Web.Models.Tenants.UpdateTenantViewModel

@{
    ViewData["Title"] = "Sửa chi nhánh";
}

<style>
    .tenant-edit-card {
        background: #fff;
        border: 1px solid #eee4da;
        border-radius: 18px;
        padding: 32px;
        box-shadow: 0 5px 20px rgba(50, 30, 15, 0.04);
    }

        .tenant-edit-card h3 {
            color: #302016;
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .tenant-edit-card .description {
            color: #a18b7c;
            margin-bottom: 28px;
        }

    .tenant-edit-group {
        margin-bottom: 22px;
    }

        .tenant-edit-group label {
            display: block;
            font-weight: 600;
            color: #493326;
            margin-bottom: 9px;
        }

        .tenant-edit-group input,
        .tenant-edit-group textarea {
            width: 100%;
            box-sizing: border-box;
            padding: 13px 15px;
            border: 1px solid #e7ddd3;
            border-radius: 9px;
            font-size: 14px;
            outline: none;
        }

            .tenant-edit-group input:focus,
            .tenant-edit-group textarea:focus {
                border-color: #95633c;
                box-shadow: 0 0 0 3px rgba(149, 99, 60, .12);
            }

            .tenant-edit-group input[readonly] {
                background: #f7f3ef;
                color: #927d6c;
            }

        .tenant-edit-group textarea {
            min-height: 110px;
            resize: vertical;
        }

    .tenant-edit-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        border-top: 1px solid #eee7df;
        padding-top: 24px;
        margin-top: 25px;
    }

    .tenant-edit-btn {
        padding: 12px 23px;
        border-radius: 9px;
        font-size: 14px;
        font-weight: 600;
        border: none;
        text-decoration: none;
        cursor: pointer;
    }

    .tenant-edit-save {
        background: #95633c;
        color: white;
    }

    .tenant-edit-cancel {
        background: #f4eee8;
        color: #63452f;
    }

    .tenant-edit-error {
        color: #dc3545;
        font-size: 13px;
    }
</style>

<div class="tenant-create">

    <div style="margin-bottom:28px;">
        <div style="font-size:12px; letter-spacing:2px; color:#a77951;">
            MANAGEMENT / BRANCHES
        </div>

        <h2 style="font-size:28px; font-weight:700; color:#302016;">
            Chỉnh sửa chi nhánh
        </h2>

        <p style="color:#9b8575;">
            Cập nhật thông tin cơ sở Trung Nguyên Cafe.
        </p>
    </div>

    <div class="tenant-edit-card">

        <h3>Thông tin chi nhánh</h3>

        <p class="description">
            Kiểm tra và cập nhật thông tin bên dưới.
        </p>

        <form asp-controller="Tenants"
              asp-action="Edit"
              method="post">

            <input type="hidden" asp-for="TenantId" />

            <div asp-validation-summary="ModelOnly"
                 class="tenant-edit-error">
            </div>

            <div class="tenant-edit-group">
                <label asp-for="TenantCode">Mã chi nhánh</label>

                <input asp-for="TenantCode" readonly />

                <span asp-validation-for="TenantCode"
                      class="tenant-edit-error"></span>
            </div>

            <div class="tenant-edit-group">
                <label asp-for="TenantName">Tên chi nhánh *</label>

                <input asp-for="TenantName"
                       placeholder="Nhập tên chi nhánh" />

                <span asp-validation-for="TenantName"
                      class="tenant-edit-error"></span>
            </div>

            <div class="tenant-edit-group">
                <label asp-for="Address">Địa chỉ chi nhánh *</label>

                <textarea asp-for="Address"
                          placeholder="Nhập địa chỉ chi nhánh"></textarea>

                <span asp-validation-for="Address"
                      class="tenant-edit-error"></span>
            </div>

            <div class="tenant-edit-actions">

                <a asp-controller="Tenants"
                   asp-action="Index"
                   class="tenant-edit-btn tenant-edit-cancel">
                    Hủy
                </a>

                <button type="submit"
                        class="tenant-edit-btn tenant-edit-save">
                    Lưu thay đổi
                </button>

            </div>

        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
