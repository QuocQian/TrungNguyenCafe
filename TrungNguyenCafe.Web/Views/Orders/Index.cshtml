        }

        .pos-menu-hint {
            width: 100%;
        }

        .pos-cart-total > strong {
            font-size: 18px;
        }
    }

</style>


@section Scripts {

    <script>
        (() => {

            // =====================================
            // KHỞI TẠO GIỎ HÀNG
            // =====================================

            const cart = new Map();

            const cartRows = document.getElementById("cartRows");
            const hiddenInputs = document.getElementById("cartHiddenInputs");

            const cartTotal = document.getElementById("cartTotal");
            const cartSubtotal = document.getElementById("cartSubtotal");
            const cartQuantity = document.getElementById("cartQuantity");
            const cartCount = document.getElementById("cartCount");

            const orderForm = document.getElementById("orderForm");
            const createOrderButton =
                document.getElementById("createOrderButton");

            const searchInput = document.getElementById("productSearch");
            const clearSearchButton =
                document.getElementById("clearProductSearch");

            const noProductResult =
                document.getElementById("noProductResult");

            const formatter = new Intl.NumberFormat("vi-VN");

            function formatMoney(value) {
                return formatter.format(value) + " đ";
            }

            function makeButton(className, text, ariaLabel) {

                const button = document.createElement("button");

                button.type = "button";
                button.className = className;
                button.textContent = text;

                if (ariaLabel) {
                    button.setAttribute("aria-label", ariaLabel);
                }

                return button;
            }


            // =====================================
            // THÊM SẢN PHẨM VÀO GIỎ
            // =====================================

            document.querySelectorAll(".add-to-cart").forEach(button => {

                button.addEventListener("click", () => {

                    const id = button.dataset.productId;
                    const name = button.dataset.productName;
                    const price = Number(button.dataset.price);

                    if (!id || !name ||
                        !Number.isFinite(price) || price < 0) {

                        alert("Thông tin sản phẩm không hợp lệ.");
                        return;
                    }

                    if (cart.has(id)) {

                        cart.get(id).quantity += 1;

                    } else {

                        cart.set(id, {
                            productId: id,
                            productName: name,
                            price: price,
                            quantity: 1
                        });

                    }

                    renderCart();

                    const originalText = button.innerHTML;

                    button.classList.add("added");
                    button.innerHTML = "<span>✓</span> Đã thêm";

                    window.setTimeout(() => {

                        button.classList.remove("added");
                        button.innerHTML = originalText;

                    }, 650);

                });

            });


            // =====================================
            // HIỂN THỊ GIỎ HÀNG
            // =====================================

            function renderCart() {

                if (!cartRows || !hiddenInputs) return;

                cartRows.innerHTML = "";
                hiddenInputs.innerHTML = "";

                let total = 0;
                let totalQuantity = 0;
                let index = 0;

                if (cart.size === 0) {

                    const empty = document.createElement("div");
                    empty.className = "pos-cart-empty";

                    const icon = document.createElement("div");
                    icon.className = "pos-cart-empty-icon";
                    icon.textContent = "🛍";

                    const title = document.createElement("strong");
                    title.textContent = "Giỏ hàng đang trống";

                    const description = document.createElement("p");
                    description.textContent =
                        "Chọn sản phẩm từ menu để bắt đầu tạo đơn.";

                    empty.append(icon, title, description);
                    cartRows.appendChild(empty);

                }

                cart.forEach(item => {

                    const subtotal = item.price * item.quantity;

                    total += subtotal;
                    totalQuantity += item.quantity;

                    // DÒNG SẢN PHẨM

                    const row = document.createElement("div");
                    row.className = "pos-cart-item";

                    const info = document.createElement("div");

                    const name = document.createElement("div");
                    name.className = "pos-cart-item-name";
                    name.textContent = item.productName;

                    const unitPrice = document.createElement("div");
                    unitPrice.className = "pos-cart-item-price";
                    unitPrice.textContent =
                        formatMoney(item.price) + " / sản phẩm";

                    // NÚT ĐIỀU CHỈNH SỐ LƯỢNG

                    const controls = document.createElement("div");
                    controls.className = "pos-cart-item-controls";

                    const minus = makeButton(
                        "pos-qty-button",
                        "−",
                        "Giảm số lượng"
                    );

                    minus.addEventListener("click", () => {

                        item.quantity -= 1;

                        if (item.quantity <= 0) {
                            cart.delete(item.productId);
                        }

                        renderCart();

                    });

                    const quantity = document.createElement("span");
                    quantity.className = "pos-qty-value";
                    quantity.textContent = item.quantity;

                    const plus = makeButton(
                        "pos-qty-button",
                        "+",
                        "Tăng số lượng"
                    );

                    plus.addEventListener("click", () => {

                        item.quantity += 1;
                        renderCart();

                    });

                    const remove = makeButton(
                        "pos-remove-button",
                        "Xóa",
                        "Xóa sản phẩm khỏi giỏ hàng"
                    );

                    remove.addEventListener("click", () => {

                        cart.delete(item.productId);
                        renderCart();

                    });

                    controls.append(minus, quantity, plus, remove);

                    info.append(name, unitPrice, controls);

                    // THÀNH TIỀN

                    const amount = document.createElement("div");
                    amount.className = "pos-cart-item-subtotal";
                    amount.textContent = formatMoney(subtotal);

                    row.append(info, amount);
                    cartRows.appendChild(row);

                    // =================================
                    // DỮ LIỆU GỬI LÊN CONTROLLER
                    // =================================

                    const productIdInput =
                        document.createElement("input");

                    productIdInput.type = "hidden";
                    productIdInput.name =
                        `Items[${index}].ProductId`;

                    productIdInput.value = item.productId;

                    const quantityInput =
                        document.createElement("input");

                    quantityInput.type = "hidden";
                    quantityInput.name =
                        `Items[${index}].Quantity`;

                    quantityInput.value = item.quantity;

                    hiddenInputs.append(
                        productIdInput,
                        quantityInput
                    );

                    index++;

                });

                // CẬP NHẬT TỔNG TIỀN

                if (cartTotal) {
                    cartTotal.textContent = formatMoney(total);
                }

                if (cartSubtotal) {
                    cartSubtotal.textContent = formatMoney(total);
                }

                if (cartQuantity) {
                    cartQuantity.textContent = totalQuantity;
                }

                if (cartCount) {
                    cartCount.textContent = cart.size;
                }

                if (createOrderButton) {
                    createOrderButton.disabled = cart.size === 0;
                }

            }


            // =====================================
            // TÌM KIẾM SẢN PHẨM
            // =====================================

            function filterProducts() {

                if (!searchInput) return;

                const keyword = searchInput.value
                    .trim()
                    .toLocaleLowerCase("vi");

                const cards =
                    document.querySelectorAll(".pos-product-card");

                let visibleCount = 0;

                cards.forEach(card => {

                    const text = (
                        card.dataset.productSearch || ""
                    ).toLocaleLowerCase("vi");

                    const matched = text.includes(keyword);

                    card.hidden = !matched;

                    if (matched) {
                        visibleCount++;
                    }

                });

                if (noProductResult) {

                    noProductResult.hidden =
                        cards.length === 0 || visibleCount > 0;

                }

                if (clearSearchButton) {

                    clearSearchButton.hidden =
                        keyword.length === 0;

                }

            }

            searchInput?.addEventListener(
                "input",
                filterProducts
            );

            clearSearchButton?.addEventListener("click", () => {

                searchInput.value = "";

                filterProducts();

                searchInput.focus();

            });


            // =====================================
            // KIỂM TRA TRƯỚC KHI TẠO ĐƠN
            // =====================================

            orderForm?.addEventListener("submit", event => {

                if (cart.size === 0) {

                    event.preventDefault();

                    alert(
                        "Vui lòng chọn ít nhất một sản phẩm trước khi tạo đơn hàng."
                    );

                    return;
                }

                if (createOrderButton) {

                    createOrderButton.disabled = true;

                    createOrderButton.textContent =
                        "Đang tạo đơn hàng...";

                }

            });


            // KHỞI TẠO
            renderCart();

        })();
    </script>

}
