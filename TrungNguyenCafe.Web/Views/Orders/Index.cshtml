@model TrungNguyenCafe.Web.Models.Orders.PosViewModel
@using System
@using System.Linq

@{
    ViewData["Title"] = "Bán hàng POS";

    var selectedTenant = Model.Tenants
        .FirstOrDefault(x => Model.TenantId.HasValue &&
                             x.TenantId == Model.TenantId.Value);
}

<div class="pos-page">

    <!-- HEADER -->
    <div class="pos-heading">
        <div>
            <div class="pos-eyebrow">TRUNG NGUYEN CAFE / POINT OF SALE</div>
            <h1>Bán hàng POS</h1>
            <p>Tạo đơn hàng nhanh chóng và quản lý sản phẩm tại quầy.</p>
        </div>

        <a asp-controller="Orders"
           asp-action="History"
           class="pos-history-link">
            <span class="pos-history-icon">▤</span>
            <span>Lịch sử đơn hàng</span>
        </a>
    </div>

    <!-- THÔNG BÁO -->
    @if (TempData["Error"] != null)
    {
        <div class="pos-alert pos-alert-error">
            <span class="pos-alert-symbol">!</span>
            <span>@TempData["Error"]</span>
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="pos-alert pos-alert-success">
            <span class="pos-alert-symbol">✓</span>
            <span>@TempData["Success"]</span>
        </div>
    }

    <!-- CHỌN CHI NHÁNH -->
    @if (Model.IsAdmin)
    {
        <section class="pos-branch-panel">
            <div class="pos-branch-intro">
                <div class="pos-branch-icon">⌂</div>
                <div>
                    <h2>Chi nhánh bán hàng</h2>
                    <p>Chọn chi nhánh để tải đúng danh sách sản phẩm và tạo đơn hàng.</p>
                </div>
            </div>

            <form asp-action="Index" method="get" class="pos-branch-form">
                <div class="pos-field">
                    <label for="tenantId">Chi nhánh</label>

                    <select id="tenantId" name="tenantId" required>
                        <option value="">-- Chọn chi nhánh --</option>

                        @foreach (var tenant in Model.Tenants)
                        {
                            <option value="@tenant.TenantId"
                                    selected="@(Model.TenantId == tenant.TenantId)">
                                @tenant.TenantCode - @tenant.TenantName
                            </option>
                        }
                    </select>
                </div>

                <button type="submit" class="pos-branch-button">
                    Xác nhận chi nhánh
                    <span>→</span>
                </button>
            </form>
        </section>
    }
    else if (Model.TenantId.HasValue)
    {
        <section class="pos-current-branch">
            <div class="pos-current-branch-icon">✓</div>
            <div>
                <span>CHI NHÁNH ĐANG BÁN HÀNG</span>
                <strong>Chi nhánh được xác định theo tài khoản đăng nhập</strong>
            </div>
            <span class="pos-verified-pill">Đã xác thực</span>
        </section>
    }

    <!-- KHU VỰC BÁN HÀNG -->
    @if (Model.TenantId.HasValue)
    {
        <div class="pos-workspace">

            <!-- DANH SÁCH SẢN PHẨM -->
            <section class="pos-products-panel">

                <div class="pos-panel-heading">
                    <div>
                        <div class="pos-section-kicker">MENU</div>
                        <h2>Danh sách sản phẩm</h2>
                        <p>Chọn sản phẩm để thêm nhanh vào giỏ hàng.</p>
                    </div>

                    <div class="pos-product-count">
                        <strong>@Model.Products.Count</strong>
                        <span>sản phẩm</span>
                    </div>
                </div>

                <!-- TÌM KIẾM -->
                <div class="pos-product-toolbar">

                    <div class="pos-search">
                        <span class="pos-search-icon">⌕</span>

                        <input type="search"
                               id="productSearch"
                               placeholder="Tìm kiếm tên sản phẩm..."
                               autocomplete="off" />

                        <button type="button"
                                id="clearProductSearch"
                                class="pos-search-clear"
                                aria-label="Xóa tìm kiếm"
                                hidden>
                            ×
                        </button>
                    </div>

                    <div class="pos-menu-hint">
                        <span class="pos-live-dot"></span>
                        Sản phẩm đang kinh doanh
                    </div>

                </div>

                @if (Model.Products.Count == 0)
                {
                    <div class="pos-empty-products">
                        <div class="pos-empty-icon">☕</div>
                        <h3>Chưa có sản phẩm để bán</h3>
                        <p>
                            Chi nhánh hiện chưa có sản phẩm đang kinh doanh.
                            Vui lòng kiểm tra lại danh mục sản phẩm.
                        </p>
                    </div>
                }
                else
                {
                    <div class="pos-product-grid" id="productGrid">

                        @foreach (var product in Model.Products)
                        {
                            // Làm tròn giá đến đồng để đồng bộ menu và giỏ hàng.
                            var displayPrice = Math.Round(
                            product.Price,
                            0,
                            MidpointRounding.AwayFromZero);

                            <article class="pos-product-card"
                                     data-product-search="@product.ProductName.ToLowerInvariant()">

                                <div class="pos-product-card-top">
                                    <div class="pos-product-visual">
                                        <span>☕</span>
                                    </div>

                                    <span class="pos-product-status">
                                        Đang bán
                                    </span>
                                </div>

                                <div class="pos-product-info">
                                    <h3>@product.ProductName</h3>

                                    <div class="pos-product-price">
                                        @displayPrice.ToString("N0") <span>đ</span>
                                    </div>
                                </div>

                                <button type="button"
                                        class="pos-add-button add-to-cart"
                                        data-product-id="@product.ProductId"
                                        data-product-name="@product.ProductName"
                                        data-price="@displayPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)">

                                    <span>＋</span>
                                    Thêm vào giỏ
                                </button>

                            </article>
                        }

                    </div>

                    <div class="pos-no-search-result"
                         id="noProductResult"
                         hidden>

                        <span>⌕</span>
                        <strong>Không tìm thấy sản phẩm</strong>
                        <p>Thử tìm bằng tên sản phẩm khác.</p>

                    </div>
                }

            </section>

            <!-- GIỎ HÀNG -->
            <aside class="pos-cart-panel">

                <div class="pos-cart-heading">
                    <div>
                        <div class="pos-section-kicker">CURRENT ORDER</div>
                        <h2>Giỏ hàng</h2>
                    </div>

                    <div class="pos-cart-count" id="cartCount">0</div>
                </div>

                <!-- CHI NHÁNH -->
                <div class="pos-cart-branch">
                    <span class="pos-cart-branch-icon">⌂</span>

                    <div>
                        <small>Đơn hàng tại</small>

                        <strong>
                            @if (Model.IsAdmin && selectedTenant != null)
                            {
                                @selectedTenant.TenantName
                            }
                            else
                            {
                                @:Chi nhánh của tài khoản
                            }
                        </strong>
                    </div>
                </div>

                <!-- FORM TẠO ĐƠN -->
                <form asp-action="Create"
                      method="post"
                      id="orderForm"
                      class="pos-order-form">

                    @Html.AntiForgeryToken()

                    @if (Model.IsAdmin)
                    {
                        <input type="hidden"
                               name="TenantId"
                               value="@Model.TenantId" />
                    }

                    <!-- SẢN PHẨM TRONG GIỎ -->
                    <div class="pos-cart-items" id="cartRows">

                        <div class="pos-cart-empty">
                            <div class="pos-cart-empty-icon">🛍</div>
                            <strong>Giỏ hàng đang trống</strong>
                            <p>Chọn sản phẩm từ menu để bắt đầu tạo đơn.</p>
                        </div>

                    </div>

                    <!-- DỮ LIỆU GỬI BACKEND -->
                    <div id="cartHiddenInputs"></div>

                    <!-- TỔNG TIỀN -->
                    <div class="pos-cart-bottom">

                        <div class="pos-cart-summary-line">
                            <span>Số lượng sản phẩm</span>
                            <strong id="cartQuantity">0</strong>
                        </div>

                        <div class="pos-cart-summary-line">
                            <span>Tạm tính</span>
                            <strong id="cartSubtotal">0 đ</strong>
                        </div>

                        <div class="pos-cart-total">
                            <div>
                                <span>TỔNG THANH TOÁN</span>
                                <small>Giá trị đơn hàng</small>
                            </div>

                            <strong id="cartTotal">0 đ</strong>
                        </div>

                        <button type="submit"
                                class="pos-create-button"
                                id="createOrderButton"
                                disabled>

                            <span>▤</span>
                            Tạo đơn hàng
                            <b>→</b>

                        </button>

                        <p class="pos-cart-note">
                            Đơn hàng sau khi tạo sẽ được lưu vào lịch sử đơn hàng.
                        </p>

                    </div>

                </form>

            </aside>

        </div>
    }
    else if (Model.IsAdmin)
    {
        <section class="pos-branch-empty">
            <div class="pos-branch-empty-icon">☕</div>
            <h2>Sẵn sàng cho ca bán hàng?</h2>
            <p>
                Vui lòng chọn chi nhánh ở phía trên.
                Hệ thống sẽ tải danh sách sản phẩm tương ứng
                để bạn bắt đầu tạo đơn.
            </p>
        </section>
    }

</div>


<style>

    /* TỔNG THỂ */

    .pos-page {
        width: 100%;
        max-width: 1600px;
        margin: 0 auto;
        color: #34271e;
    }

    .pos-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 25px;
    }

    .pos-eyebrow,
    .pos-section-kicker {
        color: #ad8054;
        font-size: 10px;
        font-weight: 750;
        letter-spacing: 1.6px;
        margin-bottom: 8px;
    }

    .pos-heading h1 {
        color: #30231a;
        font-size: 28px;
        font-weight: 750;
        margin: 0 0 7px;
    }

    .pos-heading p {
        color: #948576;
        font-size: 13px;
        margin: 0;
    }

    .pos-history-link {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 12px 16px;
        border: 1px solid #e9ded2;
        border-radius: 9px;
        background: #fff;
        color: #765237;
        text-decoration: none;
        font-size: 12px;
        font-weight: 650;
        white-space: nowrap;
        transition: .2s ease;
    }

        .pos-history-link:hover {
            border-color: #b98550;
            background: #fbf7f2;
            color: #493022;
            transform: translateY(-1px);
        }

    .pos-history-icon {
        font-size: 17px;
    }

    /* THÔNG BÁO */

    .pos-alert {
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 13px 16px;
        border-radius: 9px;
        margin-bottom: 18px;
        font-size: 13px;
    }

    .pos-alert-error {
        background: #fff0ed;
        border: 1px solid #f1c9c1;
        color: #a44335;
    }

    .pos-alert-success {
        background: #edf7ef;
        border: 1px solid #cce7d1;
        color: #34794a;
    }

    .pos-alert-symbol {
        display: grid;
        place-items: center;
        width: 23px;
        height: 23px;
        flex: 0 0 23px;
        border-radius: 50%;
        background: rgba(0,0,0,.06);
        font-weight: 800;
    }

    /* CHỌN CHI NHÁNH */

    .pos-branch-panel {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        padding: 19px 22px;
        margin-bottom: 22px;
        background: #fff;
        border: 1px solid #eee5db;
        border-radius: 13px;
        box-shadow: 0 4px 15px rgba(50,35,20,.025);
    }

    .pos-branch-intro {
        display: flex;
        align-items: center;
        gap: 13px;
        min-width: 230px;
    }

    .pos-branch-icon {
        display: grid;
        place-items: center;
        width: 45px;
        height: 45px;
        border-radius: 12px;
        background: #f5ece2;
        color: #93643b;
        font-size: 23px;
    }

    .pos-branch-intro h2 {
        color: #3d2c20;
        font-size: 14px;
        font-weight: 750;
        margin: 0 0 5px;
    }

    .pos-branch-intro p {
        color: #9a8b7d;
        font-size: 11px;
        margin: 0;
    }

    .pos-branch-form {
        display: flex;
        align-items: end;
        gap: 10px;
        flex: 1;
        max-width: 620px;
    }

    .pos-field {
        display: flex;
        flex-direction: column;
        gap: 7px;
        flex: 1;
    }

        .pos-field label {
            color: #78634f;
            font-size: 11px;
            font-weight: 700;
        }

        .pos-field select {
            width: 100%;
            height: 43px;
            padding: 0 13px;
            border: 1px solid #e8ded3;
            border-radius: 8px;
            background: #fff;
            color: #49382a;
            font: inherit;
            font-size: 12px;
            outline: none;
        }

            .pos-field select:focus {
                border-color: #b98550;
                box-shadow: 0 0 0 3px rgba(185,133,80,.12);
            }

    .pos-branch-button {
        height: 43px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 13px;
        padding: 0 18px;
        border: 0;
        border-radius: 8px;
        background: #493022;
        color: #fff;
        font: inherit;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
        white-space: nowrap;
        transition: .2s;
    }

        .pos-branch-button:hover {
            background: #765035;
        }

    .pos-current-branch {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 13px 17px;
        margin-bottom: 21px;
        border: 1px solid #dcebdd;
        border-radius: 10px;
        background: #f3faf3;
    }

    .pos-current-branch-icon {
        display: grid;
        place-items: center;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: #e0f1e2;
        color: #31834b;
        font-weight: 800;
    }

    .pos-current-branch div:nth-child(2) {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .pos-current-branch span:first-child {
        color: #6f9274;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 1px;
    }

    .pos-current-branch strong {
        color: #385e40;
        font-size: 12px;
    }

    .pos-verified-pill {
        margin-left: auto;
        padding: 6px 10px;
        border-radius: 20px;
        background: #e3f3e5;
        color: #34804b;
        font-size: 10px;
        font-weight: 700;
    }

    /* BỐ CỤC POS */

    .pos-workspace {
        display: grid;
        grid-template-columns: minmax(0, 1.7fr) minmax(330px, .85fr);
        align-items: start;
        gap: 20px;
    }

    .pos-products-panel,
    .pos-cart-panel {
        min-width: 0;
        background: #fff;
        border: 1px solid #eee6dd;
        border-radius: 13px;
        box-shadow: 0 4px 17px rgba(50,35,20,.03);
    }

    .pos-products-panel {
        padding: 22px;
    }

    .pos-panel-heading,
    .pos-cart-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
    }

        .pos-panel-heading h2,
        .pos-cart-heading h2 {
            color: #38291e;
            font-size: 18px;
            font-weight: 750;
            margin: 0 0 6px;
        }

        .pos-panel-heading p {
            color: #9a8b7d;
            font-size: 11px;
            margin: 0;
        }

    .pos-product-count {
        display: flex;
        align-items: baseline;
        gap: 5px;
        padding: 8px 11px;
        border-radius: 8px;
        background: #f7f1eb;
        color: #95704d;
        font-size: 10px;
        white-space: nowrap;
    }

        .pos-product-count strong {
            color: #68472e;
            font-size: 15px;
        }

    /* TÌM KIẾM */

    .pos-product-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        margin: 21px 0 18px;
    }

    .pos-search {
        display: flex;
        align-items: center;
        gap: 9px;
        width: min(100%, 370px);
        height: 42px;
        padding: 0 12px;
        border: 1px solid #e9e0d7;
        border-radius: 8px;
        background: #fff;
        transition: .2s;
    }

        .pos-search:focus-within {
            border-color: #b98550;
            box-shadow: 0 0 0 3px rgba(185,133,80,.10);
        }

    .pos-search-icon {
        color: #a98b6e;
        font-size: 22px;
        line-height: 1;
    }

    .pos-search input {
        width: 100%;
        min-width: 0;
        border: 0;
        outline: 0;
        background: transparent;
        color: #443327;
        font: inherit;
        font-size: 12px;
    }

        .pos-search input::placeholder {
            color: #b0a397;
        }

    .pos-search-clear {
        border: 0;
        background: transparent;
        color: #9b8978;
        font-size: 20px;
        cursor: pointer;
    }

    .pos-menu-hint {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: #8e8174;
        font-size: 10px;
    }

    .pos-live-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #4ba66b;
        box-shadow: 0 0 0 3px #e8f4eb;
    }

    /* SẢN PHẨM */

    .pos-product-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
    }

    .pos-product-card[hidden],
    .pos-no-search-result[hidden],
    .pos-search-clear[hidden] {
        display: none !important;
    }

    .pos-product-card {
        display: flex;
        flex-direction: column;
        min-width: 0;
        padding: 14px;
        border: 1px solid #eee7df;
        border-radius: 11px;
        background: #fff;
        transition: .2s ease;
    }

        .pos-product-card:hover {
            border-color: #d6b995;
            box-shadow: 0 7px 18px rgba(70,48,29,.07);
            transform: translateY(-2px);
        }

    .pos-product-card-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 7px;
        margin-bottom: 13px;
    }

    .pos-product-visual {
        display: grid;
        place-items: center;
        width: 47px;
        height: 47px;
        border-radius: 12px;
        background: linear-gradient(145deg,#f8efe5,#efe0cf);
        color: #865a39;
        font-size: 25px;
    }

    .pos-product-status {
        padding: 5px 7px;
        border-radius: 20px;
        background: #eaf5ec;
        color: #438353;
        font-size: 9px;
        font-weight: 700;
        white-space: nowrap;
    }

    .pos-product-info {
        flex: 1;
        min-height: 65px;
    }

        .pos-product-info h3 {
            display: -webkit-box;
            overflow: hidden;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            color: #443226;
            font-size: 13px;
            font-weight: 750;
            line-height: 1.45;
            margin: 0 0 8px;
            overflow-wrap: anywhere;
        }

    .pos-product-price {
        color: #9a6336;
        font-size: 15px;
        font-weight: 800;
    }

        .pos-product-price span {
            font-size: 11px;
            font-weight: 650;
        }

    .pos-add-button {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        width: 100%;
        min-height: 37px;
        margin-top: 14px;
        border: 1px solid #ead9c6;
        border-radius: 7px;
        background: #fbf7f2;
        color: #765034;
        font: inherit;
        font-size: 11px;
        font-weight: 750;
        cursor: pointer;
        transition: .2s;
    }

        .pos-add-button span {
            font-size: 17px;
            line-height: 1;
        }

        .pos-add-button:hover {
            border-color: #493022;
            background: #493022;
            color: #fff;
        }

        .pos-add-button.added {
            background: #eaf5ec;
            border-color: #cce7d1;
            color: #34794a;
        }

    .pos-empty-products,
    .pos-no-search-result {
        padding: 54px 20px;
        text-align: center;
    }

        .pos-empty-icon,
        .pos-no-search-result > span {
            display: block;
            margin-bottom: 13px;
            color: #b28a63;
            font-size: 38px;
        }

        .pos-empty-products h3,
        .pos-no-search-result strong {
            display: block;
            color: #4b3829;
            font-size: 14px;
            margin: 0 0 7px;
        }

        .pos-empty-products p,
        .pos-no-search-result p {
            max-width: 360px;
            margin: 0 auto;
            color: #a09285;
            font-size: 11px;
            line-height: 1.7;
        }

    /* GIỎ HÀNG */

    .pos-cart-panel {
        position: sticky;
        top: 18px;
        overflow: hidden;
    }

    .pos-cart-heading {
        padding: 21px 21px 17px;
        border-bottom: 1px solid #f0ebe5;
    }

        .pos-cart-heading h2 {
            margin-bottom: 0;
        }

    .pos-cart-count {
        display: grid;
        place-items: center;
        min-width: 31px;
        height: 31px;
        padding: 0 8px;
        border-radius: 9px;
        background: #f4e9dc;
        color: #825a38;
        font-size: 12px;
        font-weight: 800;
    }

    .pos-cart-branch {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 13px 20px;
        background: #fcfaf7;
        border-bottom: 1px solid #f0ebe5;
    }

    .pos-cart-branch-icon {
        display: grid;
        place-items: center;
        width: 34px;
        height: 34px;
        border-radius: 9px;
